#!/usr/bin/env bash
# AppRun for launchermodular: keeps linuxdeploy's Qt relocation (qt.conf next
# to the binary) and adds the application's private QML modules, whose
# compiled-in path (/usr/lib/<triplet>/launchermodular) points outside the
# AppImage mount.
HERE="$(dirname "$(readlink -f "$0")")"
# The AppImage runtime sets $APPDIR only when mounting; keep our own tree
# resolvable when the AppImage was extracted (--appimage-extract, no FUSE).
export APPDIR="${APPDIR:-$HERE}"
# Icons collected at build time live inside the bundle. Qt only looks in the
# system data directories unless XDG_DATA_DIRS points inside the AppImage, so
# Icon { name: … } would stay empty (see VALIDATION_PACKAGES.md, T2).
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for d in "$HERE"/usr/lib/*/launchermodular; do
    [ -d "$d" ] || continue
    export QML2_IMPORT_PATH="$d${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
done
exec "$HERE"/usr/bin/launchermodular "$@"
